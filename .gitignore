# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# local semiconductor test data — never commit customer or production data
*.stdf
*.stdf.gz
*.std
*.std.gz
*.atdf
/data/
/customer-data/

# local commercial configuration
.license-key
.activation/

/.dev.vars*
